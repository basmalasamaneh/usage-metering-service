# Copy to .env to override compose defaults. Every value is optional.
LOG_LEVEL=info
# Protects POST /v1/accounts (account creation). Empty = open, convenient for local evaluation.
ADMIN_TOKEN=
# Max queued consume requests of one account decided in a single transaction (1 = no batching).
BATCH_MAX=64
DB_POOL_MAX=20
# 'on' = every commit is flushed to disk before it is acknowledged (default, safest).
DB_SYNCHRONOUS_COMMIT=on
